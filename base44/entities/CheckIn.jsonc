{
  "name": "CheckIn",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email"
    },
    "user_name": {
      "type": "string",
      "description": "User full name"
    },
    "barcode_number": {
      "type": "string",
      "description": "User barcode number"
    },
    "check_in_date": {
      "type": "string",
      "format": "date",
      "description": "Date of check-in"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "food_distribution",
        "volunteer",
        "other"
      ],
      "default": "food_distribution",
      "description": "Type of event"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "user_email",
    "user_name",
    "check_in_date"
  ]
}