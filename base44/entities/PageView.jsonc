{
  "name": "PageView",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who viewed the page"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the user"
    },
    "page_name": {
      "type": "string",
      "description": "Name of the page viewed"
    },
    "view_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the view"
    }
  },
  "required": [
    "user_email",
    "page_name",
    "view_date"
  ]
}