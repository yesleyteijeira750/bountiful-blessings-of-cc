{
  "name": "ResourceReview",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string",
      "description": "ID of the resource being reviewed"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the reviewer"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the reviewer"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating from 1 to 5"
    },
    "comment": {
      "type": "string",
      "description": "Review comment"
    },
    "is_approved": {
      "type": "boolean",
      "default": true,
      "description": "Whether the review is approved for display"
    }
  },
  "required": [
    "resource_id",
    "user_name",
    "rating",
    "comment"
  ]
}