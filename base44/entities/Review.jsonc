{
  "name": "Review",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string",
      "description": "Name of the person leaving the review"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating from 1 to 5"
    },
    "comment": {
      "type": "string",
      "description": "Review comment text"
    },
    "is_approved": {
      "type": "boolean",
      "default": true,
      "description": "Whether reviews are currently being accepted"
    }
  },
  "required": [
    "author_name",
    "rating",
    "comment"
  ]
}